{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/postinstall.ts"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["which", "where.exe", "powershell.exe", "osascript", "notify-send", "ioreg", "systemctl", "launchctl", "ffmpeg", "gnosys", "python3"]
}
